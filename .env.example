# Copy to .env and fill in ONE of the keys below. Never commit .env.

# Option A: Claude (Anthropic)  - https://console.anthropic.com
ANTHROPIC_API_KEY=
# BI_ASSISTANT_MODEL=claude-opus-5-5

# Option B: GPT (OpenAI)  - https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# If both keys are set, which one to start with (the web sidebar can switch): anthropic | openai
# BI_ASSISTANT_PROVIDER=anthropic

# BI_ASSISTANT_EFFORT=high          # Claude only: low | medium | high | xhigh | max
# BI_ASSISTANT_MAX_TOKENS=16000
